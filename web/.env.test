# Dummy web config for tests — VITE_USE_FIREBASE_EMULATOR below is what actually makes
# firebaseConfig.ts redirect the Firestore/Auth SDKs to the local emulator (see its
# `if (import.meta.env.VITE_USE_FIREBASE_EMULATOR === 'true')` check); the client SDK, unlike
# the Admin SDK, does NOT auto-honor FIRESTORE_EMULATOR_HOST/FIREBASE_AUTH_EMULATOR_HOST, so
# without this flag these dummy values would point at a real (nonexistent) GCP project instead
# of the `firebase emulators:exec` instance the test script starts. "demo-" prefix on the
# project id keeps the emulator fully offline (no real GCP project required) — the same
# convention scripts/firebase-admin would use locally.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-alumor-pricing
VITE_FIREBASE_STORAGE_BUCKET=demo-alumor-pricing.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
