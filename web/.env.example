# Copy to .env and fill in with your real Firebase project's web config
# (Firebase console → Project settings → General → Your apps → Web app → SDK setup and config).
# These values are public by design (they end up in the built bundle) — real protection is
# firestore.rules, not hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Leave unset to point `npm run dev` at the real project above (fine for solo/early
# testing). Set to "true" only once you actually have the Firestore/Auth emulator running
# locally (`npm run emulators` from the repo root) and want dev to use that instead.
VITE_USE_FIREBASE_EMULATOR=
