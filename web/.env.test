# Dummy web config for tests — the Firestore/Auth SDKs only ever talk to the local emulator
# in test mode (see firebaseConfig.ts's `if (import.meta.env.DEV)`), so these values never
# need to be real. "demo-" prefix on the project id keeps the emulator fully offline (no real
# GCP project required) — the same convention scripts/firebase-admin would use locally.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-alumor-pricing
VITE_FIREBASE_STORAGE_BUCKET=demo-alumor-pricing.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
